# Course 1258 — lab environment configuration
#
# Copy this file to `.env` in the same directory and fill in the key your
# instructor provides:
#
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed or shared. Real environment
# variables take precedence over anything set here.

# Provided by your instructor for this class only.
OPENAI_API_KEY=sk-REPLACE-ME

# Model aliases. Change here, not in the notebooks.
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Lab 4.1 rung 4 compares a standard model with a reasoning model.
# Confirm which reasoning model your class account has before teaching;
# left unset it falls back to OPENAI_MODEL and the lab says the
# comparison is unavailable rather than comparing a model with itself.
OPENAI_REASONING_MODEL=
# Lab 7.1 Exercise 3 varies temperature, which the gpt-5 family rejects
# ("Unsupported value: 'temperature' does not support 0.0"). That one exercise
# pins this temperature-capable model; every other cell uses OPENAI_MODEL.
OPENAI_TEMPERATURE_MODEL=gpt-4.1-mini
